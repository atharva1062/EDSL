# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (Default SQLite for instant local zero-setup)
DATABASE_URL="file:./dev.db"

# Or if using PostgreSQL (e.g. Supabase, Neon, or local PostgreSQL):
# DATABASE_URL="postgresql://postgres:password@localhost:5432/campusswap?schema=public"
# DATABASE_URL="postgresql://postgres.[ref]:[password]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Security / JWT
JWT_SECRET="campusswap_super_secret_jwt_key_2026_secure!"
JWT_EXPIRES_IN="7d"

# Allowed student email domains (comma separated) or leave empty to allow all student emails
ALLOWED_EMAIL_DOMAINS=".edu,college.edu,campus.edu,student.ac.in,atharva.edu"
